<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Surya-Shakti Solar Monitor"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFD600"
            android:layout_gravity="center"/>

        <EditText
            android:id="@+id/etGeneration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Solar Generation (kWh)"
            android:textColor="#FFFFFF"
            android:textColorHint="#FFD600"
            android:inputType="numberDecimal"
            android:backgroundTint="#FFD600"
            android:layout_marginTop="40dp"/>

        <EditText
            android:id="@+id/etConsumption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Electricity Consumption (kWh)"
            android:textColor="#FFFFFF"
            android:textColorHint="#FFD600"
            android:inputType="numberDecimal"
            android:backgroundTint="#FFD600"
            android:layout_marginTop="20dp"/>

        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calculate Energy"
            android:textColor="#000000"
            android:textStyle="bold"
            android:backgroundTint="#FFD600"
            android:layout_marginTop="30dp"/>

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Result"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:layout_marginTop="40dp"/>

    </LinearLayout>

</ScrollView>